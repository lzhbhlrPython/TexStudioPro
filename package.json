{
  "name": "texstudio-pro",
  "version": "0.1.0",
  "private": true,
  "description": "A writing-first LaTeX editor that combines continuous inline writing with project, compile and SyncTeX tools.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "smoke": "npm run build && cross-env TEXPRO_SMOKE=1 electron .",
    "smoke:welcome": "npm run build && cross-env TEXPRO_SMOKE=1 TEXPRO_SMOKE_WELCOME=1 electron .",
    "test:compile": "node scripts/test-compile.mjs",
    "package": "npm run build && electron-builder --mac --dir",
    "test:import": "node scripts/test-import.mjs",
    "test:mcp": "node scripts/test-mcp.mjs",
    "nightly:version": "node scripts/set-nightly-version.mjs",
    "package:mac": "npm run build && electron-builder --mac --universal",
    "package:win": "npm run build && electron-builder --win nsis portable zip --x64",
    "package:linux": "npm run build && electron-builder --linux AppImage deb rpm --x64",
    "verify:release": "node scripts/verify-release.cjs",
    "test:regression": "node --test tests/*.test.cjs",
    "test:ui": "node scripts/test-ui.cjs",
    "test:music": "node scripts/test-music.cjs",
    "test:music:ui": "node scripts/test-ui.cjs --music",
    "test:writing:ui": "node scripts/test-ui.cjs --writing",
    "test:assets:ui": "node scripts/test-ui.cjs --assets",
    "test:continuity:ui": "node scripts/test-ui.cjs --continuity",
    "test:flow:ui": "node scripts/test-flow-ui.cjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.9.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@lezer/highlight": "^1.2.1",
    "ink-stroke-modeler-ts": "github:WhiteboardCX/ink-stroke-modeler-ts#240d80f2c78c2f70317b498d37564f90fcddfe0c",
    "katex": "^0.19.0",
    "lucide-react": "^0.544.0",
    "pdfjs-dist": "^6.4.299",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "wait-on": "^9.0.0",
    "@electron/asar": "3.4.1"
  },
  "build": {
    "appId": "dev.texpro.app",
    "productName": "TeXPro",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "mcp/**",
      "demo/**",
      "build/icon.*",
      "package.json",
      "!node_modules/@napi-rs/canvas/**",
      "!node_modules/@napi-rs/canvas-*/**",
      "!**/node_modules/@napi-rs/canvas*/**",
      "!**/.playwright-mcp/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "TeXPro <texpro@localhost>",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "asarUnpack": [
      "mcp/**",
      "electron/services/tex.cjs",
      "electron/services/history.cjs",
      "electron/services/git.cjs",
      "electron/services/project-files.cjs",
      "electron/services/project-root.cjs",
      "electron/services/music.cjs"
    ],
    "nsis": {
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-${arch}-portable.${ext}"
    },
    "beforePack": "scripts/before-pack.cjs",
    "afterPack": "scripts/after-pack.cjs"
  }
}
